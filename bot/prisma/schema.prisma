// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
  runtime  = "deno"
}

datasource db {
  provider = "postgresql"
}

model WebTokens {
  id      Int    @id @default(autoincrement())
  guildId String
  token   String
}

model IamRoles {
  id      Int    @id @default(autoincrement())
  guildId String
  roleId  String
  tag     String
}

model WelcomeGoodbyeSettings {
  guildId                  String  @id
  welcomeEnabled           Boolean @default(false)
  welcomeChannel           String  @default("")
  welcomeType              String  @default("text")
  welcomeTitle             String  @default("Welcome {member}!")
  welcomeContent           String  @default("Welcome {name} to {server}!")
  welcomeFirstGracePeriod  Int     @default(5)
  welcomeSecondGracePeriod Int     @default(60)
  goodbyeEnabled           Boolean @default(false)
  goodbyeChannel           String  @default("")
  goodbyeType              String  @default("text")
  goodbyeTitle             String  @default("Goodbye {mention}!")
  goodbyeContent           String  @default("{server} will miss {name}. :(")
}

model WelcomeFirstGracePeriod {
  id        Int      @id @default(autoincrement())
  userId    String
  guildId   String
  expiresAt DateTime
}

model WelcomeSecondGracePeriod {
  id        Int      @id @default(autoincrement())
  userId    String
  guildId   String
  messageId String
  expiresAt DateTime
}

model ChatStreaks {
  guildId         String
  userId          String
  streakStartDate DateTime
  lastMessageDate DateTime

  @@id([guildId, userId])
}

model ServerSettings {
  guildId                       String  @id
  botChannel                    String  @default("0")
  deleteCommandMessage          Boolean @default(false)
  onlyAllowCommandsInBotChannel Boolean @default(false)
  prefix                        String  @default("a!")
}

model ChatSummary {
  id           Int    @id @default(autoincrement())
  channelId    String
  guildId      String
  messageCount Int    @default(0)

  members ChatSummaryMember[]

  @@unique([guildId, channelId])
}

model ChatSummaryMember {
  id            Int    @id @default(autoincrement())
  chatSummaryId Int
  memberId      String
  messageCount  Int    @default(0)

  channel ChatSummary @relation(fields: [chatSummaryId], references: [id])

  @@unique([memberId, chatSummaryId])
}

model MonthlyChatSummary {
  id           Int    @id @default(autoincrement())
  channelId    String
  guildId      String
  messageCount Int    @default(0)

  members MonthlyChatSummaryMember[]

  @@unique([channelId, guildId])
}

model MonthlyChatSummaryMember {
  id            Int    @id @default(autoincrement())
  chatSummaryId Int
  memberId      String
  messageCount  Int    @default(0)

  channel MonthlyChatSummary @relation(fields: [chatSummaryId], references: [id])

  @@unique([chatSummaryId, memberId])
}

model YearlyChatSummary {
  id           Int    @id @default(autoincrement())
  channelId    String
  guildId      String
  messageCount Int    @default(0)

  members YearlyChatSummaryMember[]

  @@unique([channelId, guildId])
}

model YearlyChatSummaryMember {
  id            Int    @id @default(autoincrement())
  chatSummaryId Int
  memberId      String
  messageCount  Int    @default(0)

  channel YearlyChatSummary @relation(fields: [chatSummaryId], references: [id])

  @@unique([chatSummaryId, memberId])
}

model ChatSummaryChannels {
  id        Int    @id @default(autoincrement())
  guildId   String
  channelId String
}

model ChatSummarySettings {
  guildId              String  @id
  enableExtraSummaries Boolean @default(false)
  extraSummariesRows   Int     @default(10)
  summariesRows        Int     @default(5)
  countBots            Boolean @default(false)
}

model RolesOnJoin {
  guildId String
  roleId  String

  @@id([guildId, roleId])
}

model VerificationSettings {
  guildId   String  @id
  enabled   Boolean @default(false)
  roleId    String  @default("")
  channelId String  @default("")
  method    String  @default("code")
}

model VerificationTokens {
  memberId        String
  guildId         String
  token           String
  verifyMessageId String

  @@id([memberId, guildId])
}

model MeowBackSettings {
  channelId String @id
  guildId   String

  meow   Boolean @default(false)
  waf    Boolean @default(false)
  bark   Boolean @default(false)
  colon3 Boolean @default(false)
  owo    Boolean @default(false)
  awawa  Boolean @default(false)
}

model ChatReviveSettings {
  guildId   String
  channelId String
  timeout   Int     @default(60)
  message   String  @default("This channel is quiet... anyone around?")
  roleId    String?

  @@id([guildId, channelId])
}

model ChatReviveState {
  channelId     String   @id
  lastMessageAt DateTime @default(now())
  reviveSent    Boolean  @default(false)
}

model CountingSettings {
  guildId         String
  channelId       String
  anyCount        Boolean @default(false)
  wordCount       Boolean @default(false)
  totalWordCount  Boolean @default(false)
  resetOnSameUser Boolean @default(true)
  failOnEdit      Boolean @default(true)

  @@id([guildId, channelId])
}

model CountingState {
  channelId     String  @id
  count         Int     @default(0)
  lastUserId    String  @default("")
  lastMessageId String  @default("")
}

model LevelingSettings {
  guildId              String  @id
  enabled              Boolean @default(false)
  xpPerMessage         Int     @default(3)
  xpPerLevel           Int     @default(500)
  weeklyBoostEnabled   Boolean @default(false)
  weeklyBoostStartDay  Int     @default(5)
  weeklyBoostStartHour Int     @default(15)
  weeklyBoostEndDay    Int     @default(1)
  weeklyBoostEndHour   Int     @default(3)
}

model LevelingStats {
  guildId String
  userId  String
  xp      Int     @default(0)

  @@id([guildId, userId])
}

model LevelingRoleRewards {
  id      Int    @id @default(autoincrement())
  guildId String
  level   Int
  roleId  String

  @@unique([guildId, level])
}

model LevelingMultipliers {
  id         Int    @id @default(autoincrement())
  guildId    String
  multiplier Float
  startMonth Int
  startDay   Int
  endMonth   Int
  endDay     Int
}

model AntiRaidSettings {
  guildId     String @id
  logChannelId String  @default("")

  capsEnabled          Boolean @default(false)
  capsPercent          Int     @default(80)
  capsMinLength        Int     @default(10)
  capsAction           String  @default("log")
  capsTimeoutSeconds   Int     @default(60)
  capsDeleteMessages   Boolean @default(false)
  capsDmMember         Boolean @default(false)

  duplicateEnabled        Boolean @default(false)
  duplicateThreshold      Int     @default(3)
  duplicateWindow         Int     @default(30)
  duplicateAction         String  @default("log")
  duplicateTimeoutSeconds Int     @default(60)
  duplicateDeleteMessages Boolean @default(false)
  duplicateDmMember       Boolean @default(false)

  emojiEnabled          Boolean @default(false)
  emojiCount            Int     @default(5)
  emojiWindow           Int     @default(30)
  emojiCustomEmojis     Boolean @default(false)
  emojiAction           String  @default("log")
  emojiTimeoutSeconds   Int     @default(60)
  emojiDeleteMessages   Boolean @default(false)
  emojiDmMember         Boolean @default(false)

  spamEnabled          Boolean @default(false)
  spamMessages         Int     @default(5)
  spamPer              Int     @default(10)
  spamAction           String  @default("log")
  spamTimeoutSeconds   Int     @default(60)
  spamDeleteMessages   Boolean @default(false)
  spamDmMember         Boolean @default(false)

  inviteEnabled          Boolean @default(false)
  inviteThreshold        Int     @default(2)
  inviteWindow           Int     @default(60)
  inviteAction           String  @default("log")
  inviteTimeoutSeconds   Int     @default(60)
  inviteDeleteMessages   Boolean @default(false)
  inviteDmMember         Boolean @default(false)

  joinBurstEnabled          Boolean @default(false)
  joinBurstMembers          Int     @default(5)
  joinBurstWindow           Int     @default(30)
  joinBurstAction           String  @default("log")
  joinBurstTimeoutSeconds   Int     @default(60)
  joinBurstDeleteMessages   Boolean @default(false)
  joinBurstDmMember         Boolean @default(false)

  mentionEnabled          Boolean @default(false)
  mentionCount            Int     @default(5)
  mentionWindow           Int     @default(30)
  mentionAction           String  @default("log")
  mentionTimeoutSeconds   Int     @default(60)
  mentionDeleteMessages   Boolean @default(false)
  mentionDmMember         Boolean @default(false)
}

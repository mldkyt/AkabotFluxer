{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.window"],
    "types": ["node"]
  },
  "tasks": {
    "dev": "deno run --watch --allow-net main.ts"
  },
  "imports": {
    "@fluxerjs/core": "npm:@fluxerjs/core@^1.4.0",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.8.0",
    "@prisma/client": "npm:@prisma/client@^7.8.0",
    "@std/assert": "jsr:@std/assert@1",
    "dotenv": "npm:dotenv@^17.4.2",
    "pg": "npm:pg@^8.22.0",
    "pg-pool": "npm:pg-pool@^3.14.0",
    "prisma": "npm:prisma@^7.8.0",
    "zod": "npm:zod@^4.4.3"
  },
  "allowScripts": ["npm:@prisma/engines@7.8.0", "npm:prisma@7.8.0"],
  "fmt": {
    "lineWidth": 250
  }
}
